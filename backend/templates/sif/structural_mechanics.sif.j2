! Generated SIF file for structural mechanics simulation
! Simulation: {{ case_name }}
! Generated by ElmerFEM Educational Platform

Header
  CHECK KEYWORDS Warn
  Mesh DB "." "mesh"
  Include Path ""
  Results Directory "results"
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Coordinate Mapping(3) = 1 2 3
  {% if steady_state %}
  Simulation Type = Steady state
  Steady State Max Iterations = {{ max_iterations }}
  {% else %}
  Simulation Type = Transient
  Timestep intervals = {{ (time_end / time_step)|int }}
  Timestep sizes = {{ time_step|format_float }}
  {% endif %}
  Output Intervals = 1
  Solver Input File = {{ case_name }}.sif
  Post File = {{ case_name }}.vtu
End

Constants
  Gravity(4) = 0 -1 0 9.82
End

Body 1
  Target Bodies(1) = 1
  Name = "Body 1"
  Equation = 1
  Material = 1
  Body Force = 1
End

Solver 1
  Equation = Linear elasticity
  Procedure = "StressSolve" "StressSolver"
  Variable = -dofs 3 Displacement
  Exec Solver = Always
  Stabilize = {{ solver_settings.stabilize|format_bool }}
  Bubbles = {{ solver_settings.bubbles|format_bool }}
  Lumped Mass Matrix = {{ solver_settings.lumped_mass|format_bool }}
  Optimize Bandwidth = {{ solver_settings.optimize_bandwidth|format_bool }}
  Steady State Convergence Tolerance = {{ solver_settings.steady_state_tolerance|format_float }}
  Nonlinear System Convergence Tolerance = {{ solver_settings.nonlinear_tolerance|format_float }}
  Nonlinear System Max Iterations = {{ solver_settings.nonlinear_max_iterations }}
  Nonlinear System Newton After Iterations = 3
  Nonlinear System Newton After Tolerance = 1.0e-3
  Nonlinear System Relaxation Factor = 1
  Linear System Solver = {{ solver_settings.linear_solver }}
  Linear System Iterative Method = {{ solver_settings.linear_method }}
  Linear System Max Iterations = {{ solver_settings.linear_max_iterations }}
  Linear System Convergence Tolerance = {{ solver_settings.linear_tolerance|format_float }}
  BiCGstabl polynomial degree = 2
  Linear System Preconditioning = {{ solver_settings.linear_preconditioning }}
  Linear System ILUT Tolerance = 1.0e-3
  Linear System Abort Not Converged = False
  Linear System Residual Output = 10
  Linear System Precondition Recompute = 1
  Calculate Stresses = True
  Calculate Principal = True
  Calculate Strains = True
End

Equation 1
  Name = "Elasticity"
  Calculate Stresses = True
  Active Solvers(1) = 1
End

Material 1
  Name = "{{ material.name }}"
  Youngs modulus = {{ material.youngs_modulus|format_float }}
  Poisson ratio = {{ material.poisson_ratio|format_float }}
  Density = {{ material.density|format_float }}
  {% if material_id %}
  ! Using material from library: ID = {{ material_id }}
  {% endif %}
End

Body Force 1
  Name = "Gravity"
  Stress Bodyforce 2 = -9.82  ! Gravity in negative Y direction
End

{% for bc in boundary_conditions %}
Boundary Condition {{ bc.index }}
  Target Boundaries(1) = {{ bc.surface_id }}
  Name = "{{ bc.name }}"
  {% if bc.type == "displacement" %}
    {% if bc.component %}
  Displacement {{ bc.component }} = {{ bc.value|format_float }}
    {% else %}
  Displacement 1 = {{ bc.value|format_float }}
  Displacement 2 = {{ bc.value|format_float }}
  Displacement 3 = {{ bc.value|format_float }}
    {% endif %}
  {% elif bc.type == "fixed" %}
  Displacement 1 = 0.0
  Displacement 2 = 0.0
  Displacement 3 = 0.0
  {% elif bc.type == "force" %}
    {% if bc.component %}
  Force {{ bc.component }} = {{ bc.value|format_float }}
    {% else %}
  Force 1 = {{ bc.value|format_float }}
  Force 2 = {{ bc.value|format_float }}
  Force 3 = {{ bc.value|format_float }}
    {% endif %}
  {% elif bc.type == "pressure" %}
  Normal Force = {{ bc.value|format_float }}
  {% elif bc.type == "spring" %}
  Spring = True
    {% if bc.component %}
  Spring {{ bc.component }} = {{ bc.stiffness|format_float }}
    {% else %}
  Spring 1 = {{ bc.stiffness|format_float }}
  Spring 2 = {{ bc.stiffness|format_float }}
  Spring 3 = {{ bc.stiffness|format_float }}
    {% endif %}
  {% endif %}
End

{% endfor %} 